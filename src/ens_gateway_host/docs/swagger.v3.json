    "info": {
        "description": "ERC-3668 / CCIP-Read gateway for agent ENS records.",
        "title": "Agentic ENS Gateway API",
        "version": "1.0"
    },
    "externalDocs": {
        "description": "",
        "url": ""
    },
    "paths": {
        "/health": {
            "get": {
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.GetHealthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    }
                },
                "summary": "Health check",
                "tags": [
                    "Health"
                ]
            }
        },
        "/{sender}": {
            "post": {
                "parameters": [
                    {
                        "description": "L1 resolver address",
                        "in": "path",
                        "name": "sender",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "object"
                                    },
                                    {
                                        "$ref": "#/components/schemas/requests.ResolveOffchainQueryRequest",
                                        "summary": "body",
                                        "description": "resolver call data"
                                    }
                                ]
                            }
                        }
                    },
                    "description": "resolver call data",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.CcipReadResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.ValidationError"
                                }
                            }
                        },
                        "description": "Bad Request"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.InternalError"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "CCIP-Read gateway (POST)",
                "tags": [
                    "CCIP-Read"
                ]
            }
        },
        "/{sender}/{data}": {
            "get": {
                "parameters": [
                    {
                        "description": "L1 resolver address",
                        "in": "path",
                        "name": "sender",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "0x-hex resolver call data (optional `.json` suffix)",
                        "in": "path",
                        "name": "data",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.CcipReadResponse"
