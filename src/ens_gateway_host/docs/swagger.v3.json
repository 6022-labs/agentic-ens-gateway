                        "description": "Bad Request"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.InternalError"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "CCIP-Read gateway (GET)",
                "tags": [
                    "CCIP-Read"
                ]
            }
