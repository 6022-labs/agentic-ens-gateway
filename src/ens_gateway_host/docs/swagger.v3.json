            },
            "requests.ResolveOffchainQueryRequest": {
                "properties": {
                    "data": {
                        "type": "string"
                    },
                    "sender": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "responses.CcipReadResponse": {
                "properties": {
                    "data": {
                        "type": "string"
                    }
                },
                "type": "object"
