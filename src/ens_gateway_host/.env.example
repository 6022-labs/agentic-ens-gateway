LOG_LEVEL=info

# HTTP host
HOST__API_PORT=5000

# EVM chains hosting an AgentEnsRegistry. Add one CHAINS__<chain_id>__RPC_HTTP_URL
# per chain you want the gateway to serve. The gateway routes each CCIP-Read
# query to the chain whose id appears as the third label of the resolved ENS
# name. Registry contract addresses are code-managed (agent_ens_registries.json),
# not configured here.
CHAINS__137__RPC_HTTP_URL=
CHAINS__80002__RPC_HTTP_URL=

# Signed-response config. private_key is the 0x-prefixed hex ECDSA key the
# gateway signs responses with; the L1 resolver's `signers` set must trust the
# matching address. Never commit a real private_key.
SIGNED_RESPONSE__PRIVATE_KEY=
SIGNED_RESPONSE__TTL_SECONDS=300

# Redis cache. The gateway checks Redis before each blockchain RPC read and
# stores the result with cache.ttl_seconds TTL. Host is the host:port address
# (use redis:6379 when running via docker-compose). Redis is required.
REDIS__HOST=
REDIS__PASSWORD=
REDIS__DB=0

# TTL (seconds) for cached ENS resolution values.
CACHE__TTL_SECONDS=3600
